<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="../Theme/ShootopiaTheme.uss" />
    <ui:VisualElement name="LoadingRoot" class="full-screen-bg modal-backdrop" style="display: none; background-color: rgb(8, 10, 14); z-index: 1000; justify-content: center; align-items: center;">
        
        <!-- Center Loading Card -->
        <ui:VisualElement style="align-items: center; justify-content: center; width: 480px; padding: 30px;">
            
            <!-- Logo / Brand -->
            <ui:Label text="SHOOTOPIA" class="text-logo" style="margin-bottom: 6px; font-size: 32px; letter-spacing: 3px;" />
            <ui:Label text="VELOCITY WARS" class="text-caption text-accent-gold" style="margin-bottom: 30px; letter-spacing: 2px;" />

            <!-- Spinner / Status text -->
            <ui:Label name="LoadingStatusText" text="INITIALIZING ARENA..." class="text-title" style="font-size: 16px; margin-bottom: 16px; color: rgb(0, 240, 255);" />
            
            <!-- Progress Bar Container -->
            <ui:VisualElement style="width: 100%; height: 8px; background-color: rgba(30, 40, 60, 0.8); border-radius: 4px; overflow: hidden; border-width: 1px; border-color: rgba(0, 240, 255, 0.3); margin-bottom: 24px;">
                <ui:VisualElement name="ProgressBarFill" style="width: 0%; height: 100%; background-color: rgb(0, 240, 255); border-radius: 4px; transition-property: width; transition-duration: 0.1s;" />
            </ui:VisualElement>

            <!-- Gameplay Tip Box -->
            <ui:VisualElement class="glass-panel-subtle" style="width: 100%; align-items: center; padding: 12px 16px;">
                <ui:Label text="COMBAT INTEL" class="text-caption text-accent-cyan" style="margin-bottom: 4px;" />
                <ui:Label name="LoadingTipText" text="Maintain killstreaks to charge your velocity gauge and unleash weapon abilities!" style="font-size: 12px; color: rgb(170, 185, 205); -unity-text-align: middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
