<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="../Theme/ShootopiaTheme.uss" />
    <ui:VisualElement name="PauseMenuRoot" class="modal-backdrop" style="display: none; background-color: rgba(6, 8, 12, 0.85); z-index: 500;">
        
        <!-- Center Pause Window -->
        <ui:VisualElement class="modal-window" style="width: 440px; align-items: center; padding: 28px;">
            
            <ui:Label text="TACTICAL PAUSE" class="text-title" style="margin-bottom: 4px; letter-spacing: 2px;" />
            <ui:Label text="Match continues in the background" class="text-subtitle" style="margin-bottom: 24px; color: rgb(243, 156, 18);" />

            <ui:Button name="BtnResumeMatch" class="btn-primary" text="RESUME COMBAT" style="width: 100%; margin-bottom: 12px; height: 48px; font-size: 16px;" />
            <ui:Button name="BtnPauseSettings" class="btn-secondary" text="⚙  SETTINGS" style="width: 100%; margin-bottom: 12px; height: 44px;" />
            <ui:Button name="BtnLeaveMatch" class="btn-danger" text="✕  LEAVE MATCH" style="width: 100%; height: 44px;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
